<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CineSaver.Manager</AssemblyName><Version>1.6.0</Version>
    <LangVersion>latest</LangVersion><DebugType>none</DebugType>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\App.ico</ApplicationIcon>
    <Product>CineSaver</Product><AssemblyTitle>CineSaver Manager</AssemblyTitle><Description>CineSaver control panel</Description><Company>CineSaver</Company>
  </PropertyGroup>
  <ItemGroup><Compile Include="..\shared\SaverSettings.cs" Link="SaverSettings.cs" /></ItemGroup>
  <ItemGroup>
    <Compile Include="..\shared\AppBranding.cs" Link="AppBranding.cs" />
    <Compile Include="..\shared\UiTheme.cs" Link="UiTheme.cs" />
    <Compile Include="..\shared\ClockOptions.cs" Link="ClockOptions.cs" />
    <Compile Include="..\shared\ClockRenderer.cs" Link="ClockRenderer.cs" />
    <Compile Include="..\shared\QuickLaunch.cs" Link="QuickLaunch.cs" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="..\assets\App.ico" LogicalName="CineSaver.App.ico" />
  </ItemGroup>
</Project>
