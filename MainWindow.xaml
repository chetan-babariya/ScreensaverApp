<Window x:Class="ScreensaverApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreensaverApp"
        Title="CineSaver"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="Black">
        <local:NativeVideoHost x:Name="Player" />
    </Grid>
</Window>
